# Copiar a .env si hace falta (no subir .env al repo)

# Auth
# En producción (Render / ENV=production) JWT_SECRET es OBLIGATORIO y no puede ser el default débil.
# JWT_SECRET=cambia-esto-en-produccion-min-16-chars
# JWT_EXPIRE_DAYS=14

# CORS (comma-separated). Default: webhealthiq.com + localhost:3000
# CORS_ORIGINS=https://webhealthiq.com,https://www.webhealthiq.com,http://localhost:3000

# Entorno (opcional). Render define RENDER=true automáticamente.
# ENV=production
# DEBUG=false

# Base de datos
# Postgres (p. ej. Neon, Render, etc.):
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Sin DATABASE_URL usa SQLite en backend/data/

# Email (opcional). Sin SMTP_HOST/SMTP_USER el reset se registra en logs.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=hello@webhealthiq.com
# APP_URL=https://webhealthiq.com

# Stripe Billing (opcional en local). Sin estas keys, /api/billing/* responde 503.
# Crear productos/precios mensuales en Stripe Dashboard (Pro 4,99 EUR, Agency 14,99 EUR)
# y pegar aquí los price_… (nunca commits con secretos reales).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_AGENCY=price_...
# Opcional (defaults: APP_URL/account?billing=success y APP_URL/#pricing):
# STRIPE_SUCCESS_URL=https://webhealthiq.com/account?billing=success
# STRIPE_CANCEL_URL=https://webhealthiq.com/#pricing
